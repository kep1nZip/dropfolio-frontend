# Base URL of the Dropfolio backend, including the /api/v1 prefix.
# API_CONTRACT.md §0.1 — every path in the contract is relative to this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# This frontend's own public origin — used for canonical URLs, Open Graph tags, and the
# generated sitemap.xml/robots.txt. In production this MUST be the real custom domain
# (see AI_Agent_Rule: Anti-Vibecoded Website Standards, "Custom domain configured").
NEXT_PUBLIC_SITE_URL=http://localhost:3000
